{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "c4sino-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  // The dashboard (apps/web) is built before every deploy and served by this
  // same Worker as static assets, so API and dashboard share one origin.
  "build": {
    "command": "npm run build --workspace @dsm/web",
    "cwd": "../.."
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/interactions",
      "/auth/*",
      "/media/*",
      "/health"
    ]
  },
  // Keep Worker logs (console.log/error, exceptions) so production failures
  // can be read afterwards in the Cloudflare dashboard / API.
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SECURITY_GATEWAY",
        "class_name": "DiscordSecurityGateway"
      }
    ]
  },
  "migrations": [
    {
      "tag": "integrated-security-gateway-v1",
      "new_sqlite_classes": ["DiscordSecurityGateway"]
    }
  ],
  // database_id is omitted on purpose: wrangler provisions the D1 database
  // on the first deploy and binds it automatically.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "c4sino-admin-db"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
